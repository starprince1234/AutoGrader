# B3 runtime configuration sample. Never commit real credentials.
#
# Ports follow the platform convention (MAIN/docs/runbooks/local-development.md and
# MAIN/compose.yaml): the platform PostgreSQL is published on 55432 and NATS on
# 54222. MAIN/host checks that this file and alembic.ini agree with that compose, so
# the values below are the integration target, not a B3-local choice.
#
# B3 additionally ships its own compose.yaml (host port 55434) for module-local work
# and for the test suite: it is isolated from the platform database and it creates
# the two least-privilege roles automatically. See
# docs/runbooks/local-development.md for both flows.

# Ordinary question-bank connection: least privilege. This role has no grant on
# b3.reference_answers / b3.test_suites / b3.test_cases / b3.blobs / b3.fixtures
# (acceptance 3-10-3), so a public code path cannot read protected content.
DATABASE_URL=postgresql+psycopg://autograder_b3_app:change-me-app-local-only@localhost:55432/autograder

# Protected-content connection: used only by the publish/compile path.
DATABASE_PROTECTED_URL=postgresql+psycopg://autograder_b3_internal:change-me-internal-local-only@localhost:55432/autograder

# Migration connection (schema owner). On the platform database that is the
# platform role; on B3's local compose it is autograder_b3.
DATABASE_MIGRATION_URL=postgresql+psycopg://autograder_platform:change-me-local-only@localhost:55432/autograder

# The two role-based DSNs above require the roles to exist. B3 ships
# infra/postgres/init.sql (idempotent) as the reference provisioning script; on the
# platform database B4 owns role provisioning (RQ-B-4-10/RQ-B-4-30).

NATS_URL=nats://localhost:54222

# B4 JWKS endpoint (MAIN/contracts/openapi/b4.yaml: GET /api/v1/auth/jwks).
# Public keys only; no shared secret is configured anywhere.
B4_JWKS_URL=http://localhost:18000/api/v1/auth/jwks
B3_JWT_ISSUER=autograder
B3_JWT_AUDIENCE=autograder-api

# Service-to-service credential for GET /api/v1/question-versions/{id}/evaluation-package.
# Value is a bearer token presented by B2; B3 compares it in constant time.
B3_SERVICE_TOKEN=change-me-service-token

# Durable JetStream consumer name for autograder.v1.evaluation.completed.
B3_CONSUMER_NAME=b3-question-statistics

# The model provider, shared by both AI features (prose advice RQ-T-10 and structured draft
# generation AI-FLOW-01A). OFF unless all three are set: with no provider configured,
# POST /api/v1/questions/{id}/authoring-assistance answers 409 naming what is missing,
# POST /api/v1/question-draft-generations answers status=unavailable, no outbound call is
# made, and the authoring flow is fully usable without it.
#
# Turning it on means the teaching objective (and, for advice, the public draft view -- never
# a reference answer, a hidden case or an expected output) leaves this deployment.
#
# The endpoint is MiMo's OpenAI-Responses-compatible API: LLM_BASE_URL is a *base* URL and B3
# appends the path itself (`.../v1/responses`; a base ending in /v1, /responses or
# /chat/completions is normalised instead of doubled).
# LLM_BASE_URL=https://api.xiaomimimo.com/v1
# LLM_MODEL_NAME=mimo-v2.6-flash
# LLM_APIKEY=change-me
# LLM_TIMEOUT_SECONDS=60
#
# Structured draft generation (AI-FLOW-01A) rides on the SAME provider: one deployment,
# one model credential, one switch.
#
# The size limits are deployment decisions (context window, cost per token), not contract
# constants: the contract fixes no maximum and the client reads the live values from
# GET /api/v1/question-draft-generations/capabilities and shows them next to the control.
# B3_DRAFT_GENERATION_MAX_OBJECTIVE_CHARS=4000
# B3_DRAFT_GENERATION_MAX_CONSTRAINTS_CHARS=2000
# B3_DRAFT_GENERATION_MAX_DESIRED_CASES=25
# B3_DRAFT_GENERATION_MAX_PROPOSAL_CASES=50
# B3_DRAFT_GENERATION_RETENTION_SECONDS=86400
#
# Cost guard: per-actor calls allowed inside a sliding window, counted from the persisted
# usage ledger (so switching course cannot reset it). 0 disables the request budget. Set it
# from the provider quota this deployment actually pays for; there is no universal number.
# B3_DRAFT_GENERATION_BUDGET_REQUESTS=20
# B3_DRAFT_GENERATION_BUDGET_WINDOW_SECONDS=3600

B3_LOG_LEVEL=INFO
