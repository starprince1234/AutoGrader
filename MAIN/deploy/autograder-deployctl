#!/usr/bin/env bash
set -euo pipefail
umask 077
fail() { printf '[autograder-deployctl] ERROR: %s\n' "$*" >&2; exit 1; }
root=/opt/autograder
case "${1:-}" in
    preflight)
        exec /usr/local/lib/autograder/production-preflight.sh
        ;;
    status)
        printf 'current_release=%s\n' "$(readlink -f "$root/current" || true)"
        systemctl show autograder.service cloudflared.service \
            --property=Id,ActiveState,SubState,Result,ExecMainStatus
        ;;
    deploy)
        [[ "$#" == 3 && "$2" =~ ^[a-f0-9]{40}$ && "$3" =~ ^[1-9][0-9]*-[1-9][0-9]*$ ]] || \
            fail "usage: autograder-deployctl deploy <SHA> <run-id>-<attempt>"
        [[ "$(id -u)" == 0 ]] || fail "run as root"
        sha="$2"
        release_id="$sha-$3"
        exec 9>/run/lock/autograder-deploy.lock
        flock -x 9
        /usr/local/lib/autograder/production-preflight.sh
        export HTTP_PROXY=http://127.0.0.1:7893 HTTPS_PROXY=http://127.0.0.1:7893
        export http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY"
        export GIT_TERMINAL_PROMPT=0
        cache="$root/git-cache"
        [[ ! -L "$root" && ! -L "$cache" ]] || fail "source directories must not be symlinks"
        install -d -m 0700 "$cache"
        if [[ ! -f "$cache/config" ]]; then
            git init --bare --quiet "$cache"
            git --git-dir="$cache" remote add origin https://github.com/starprince1234/AutoGrader.git
            git --git-dir="$cache" config extensions.partialClone origin
            git --git-dir="$cache" config remote.origin.promisor true
            git --git-dir="$cache" config remote.origin.partialclonefilter blob:none
        fi
        current_main="$(timeout 30 git --git-dir="$cache" ls-remote origin refs/heads/main | awk 'NR == 1 { print $1 }')"
        [[ "$current_main" =~ ^[a-f0-9]{40}$ ]] || fail "could not resolve the production main SHA"
        if [[ "$current_main" != "$sha" ]]; then
            printf '[autograder-deployctl] skipping stale SHA %s; main is now %s\n' "$sha" "$current_main"
            exit 0
        fi
        timeout 120 git --git-dir="$cache" fetch --quiet --filter=blob:none --no-tags --depth=1 origin refs/heads/main
        [[ "$(git --git-dir="$cache" rev-parse FETCH_HEAD)" == "$sha" ]] || fail "fetched SHA mismatch"
        stage="$root/staging/$release_id"
        [[ ! -e "$stage" && ! -e "$root/releases/$release_id" ]] || fail "release ID already exists"
        install -d -m 0755 "$root/staging"
        install -d -m 0750 "$stage"
        manifest="$(git --git-dir="$cache" show "$sha:MAIN/deploy/release-manifest.txt")"
        paths=()
        while IFS= read -r path; do
            [[ -z "$path" || "$path" == \#* ]] && continue
            [[ "$path" =~ ^(B2|B3|B4|B5|MAIN)(/[A-Za-z0-9._-]+)*$ && "$path" != *..* ]] || \
                fail "invalid release manifest path"
            paths+=("$path")
        done <<< "$manifest"
        [[ "${#paths[@]}" -gt 0 ]] || fail "empty release manifest"
        timeout 180 git --git-dir="$cache" archive "$sha" "${paths[@]}" \
            | tar -x -C "$stage" --no-same-owner
        bash "$stage/MAIN/deploy/deploy-release.sh" "$sha" "$stage"
        ;;
    *) fail "usage: autograder-deployctl {preflight|status|deploy}" ;;
esac
