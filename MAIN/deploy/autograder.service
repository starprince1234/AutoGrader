[Unit]
Description=AutoGrader composition API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=autograder
Group=autograder
WorkingDirectory=/opt/autograder/current/MAIN
EnvironmentFile=/etc/autograder/runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=HTTP_PROXY=http://127.0.0.1:7893
Environment=HTTPS_PROXY=http://127.0.0.1:7893
Environment=http_proxy=http://127.0.0.1:7893
Environment=https_proxy=http://127.0.0.1:7893
Environment=NO_PROXY=localhost,127.0.0.1,::1
Environment=no_proxy=localhost,127.0.0.1,::1
# nsjail 需要在自己看到的 /sys/fs/cgroup（= 本单元的委派子树）上写 cgroup.subtree_control，
# 而内核的"no internal process"规则禁止对**自身持有进程**的 cgroup 这样做（表现为
# `write ... cgroup.subtree_control: Device or resource busy`，随后
# `Couldn't setup parent cgroup (cgroupv2)`，沙箱里每个程序都以 255 退出）。
# 因此把 API 主进程放进子 cgroup `payload`，让本单元 cgroup 保持"没有任务"，
# nsjail 就能在它下面建立 `NSJAIL.<pid>` 并写入 memory/pids/cpu 限额。
# 这一段是"能移动就移动，不能移动也照常启动"：任何一步失败都不影响 API 起来。
ExecStart=/bin/sh -c 'if mkdir -p /sys/fs/cgroup/payload 2>/dev/null && echo $$ > /sys/fs/cgroup/payload/cgroup.procs 2>/dev/null; then exec /opt/autograder/current/MAIN/.venv/bin/uvicorn autograder_host.main:app --host 127.0.0.1 --port 18000 --workers 1; fi; exec /opt/autograder/current/MAIN/.venv/bin/uvicorn autograder_host.main:app --host 127.0.0.1 --port 18000 --workers 1'
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300s
TimeoutStopSec=30s
LimitNOFILE=4096
UMask=0077

# Give the unprivileged host process a writable cgroup v2 subtree for nsjail.
Delegate=cpu memory pids
BindPaths=/sys/fs/cgroup/system.slice/autograder.service:/sys/fs/cgroup
ReadWritePaths=/var/lib/autograder /sys/fs/cgroup

# The application is non-root; only persistent runtime data and its delegated cgroup
# subtree are writable.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
MemoryMax=256M
CPUQuota=75%
TasksMax=256

[Install]
WantedBy=multi-user.target
