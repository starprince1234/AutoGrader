# AutoGrader MAIN composition host -- environment reference.
#
# This file is NOT read by `docker compose up`: every value the container needs is declared
# in `compose.yaml`, which is the deployment route. It exists so that (a) the variable
# names are discoverable in one place, and (b) a host started *outside* a container (the
# Windows route in `docs/runbooks/local-development.md`) has a template to copy.
#
# It is checked against reality rather than against the compose defaults it happens to
# share: the role names below are the ones `infra/postgres/init.sql` actually creates, and
# the ports are the ones `compose.yaml` publishes by default. `.env.example` used to name a
# role `autograder_main` that no file creates and ports 5432/4222 that nothing publishes --
# copying it produced a connection failure with no hint about which side was wrong.
#
# Copy to `.env.integration` (gitignored) before use. Placeholder passwords only.

# --- host ----------------------------------------------------------------------------
AUTOGRADER_ENV=development
B1_DIST_DIR=../B1/dist

# --- migrations and operations (never handed to a module) -----------------------------
# The platform superuser. Used by the container entrypoint's `alembic upgrade head` and by
# `python -m autograder_b4.ops.provision`. The application must never connect as this role.
DATABASE_URL=postgresql+psycopg://autograder_platform:change-me-local-only@localhost:55432/autograder

# --- shared infrastructure -----------------------------------------------------------
NATS_URL=nats://localhost:54222
JWT_ISSUER=autograder
JWT_AUDIENCE=autograder-api
JWT_PRIVATE_KEY_FILE=secrets/jwt-ed25519.pem

# --- B2 (submissions, evaluation, grades) --------------------------------------------
B2_DATABASE_URL=postgresql+psycopg://autograder_b2:change-me@localhost:55432/autograder
B2_NATS_URL=nats://localhost:54222
B2_ENV=development
B2_ARTIFACT_ROOT=.runtime/b2-artifacts
B2_WORKSPACE_ROOT=.runtime/b2-workspace
B2_JWKS_PATH=.runtime/jwks.json
B2_B3_BASE_URL=http://127.0.0.1:18000
# The whole `Authorization` header value, scheme included: B2 sends it verbatim.
B2_B3_AUTHORIZATION=Bearer local-integration-service-token

# --- B3 (question bank) --------------------------------------------------------------
B3_DATABASE_URL=postgresql+psycopg://autograder_b3_app:change-me-app-local-only@localhost:55432/autograder
B3_DATABASE_PROTECTED_URL=postgresql+psycopg://autograder_b3_internal:change-me-internal-local-only@localhost:55432/autograder
B3_NATS_URL=nats://localhost:54222
# B3 reads B4's published key set as `B4_JWKS_URL`; the provider names the variable. A
# `B3_JWKS_URL` is read by nobody and leaves the token verifier unbuilt.
B4_JWKS_URL=http://127.0.0.1:18000/api/v1/auth/jwks
B3_JWT_ISSUER=autograder
B3_JWT_AUDIENCE=autograder-api
B3_SERVICE_TOKEN=local-integration-service-token

# --- B4 (identity, courses, roster, registry, messaging) -----------------------------
B4_DATABASE_URL=postgresql+psycopg://autograder_b4:change-me@localhost:55432/autograder
B4_NATS_URL=nats://localhost:54222
B4_ENV=development
B4_JWT_ISSUER=autograder
B4_JWT_AUDIENCE=autograder-api
# Repository root holding `MAIN/contracts` and the four `B*/` roots the registry validates.
B4_MODULE_ROOT=..
