{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autograder.local/contracts/submission-envelope.schema.json",
  "type": "object",
  "required": ["submission_id", "student_id", "course_id", "section_id", "question_version_id", "files", "idempotency_key"],
  "properties": {
    "submission_id": {"type": "string", "format": "uuid"},
    "student_id": {"type": "string", "format": "uuid"},
    "course_id": {"type": "string", "format": "uuid"},
    "section_id": {"type": "string", "format": "uuid"},
    "question_version_id": {"type": "string", "format": "uuid"},
    "files": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/file"}},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "content_sha256", "content_base64"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$", "maxLength": 200},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_base64": {"type": "string", "contentEncoding": "base64", "maxLength": 2097152}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
