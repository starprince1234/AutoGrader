# B4 local development environment (copy to .env). Placeholders only -- never production values.
B4_ENV=development

# Application role: least privilege, created by `python -m autograder_b4.ops.provision`.
DATABASE_URL=postgresql+psycopg://autograder_b4:change-me@localhost:55432/autograder

# Privileged connection, used ONLY by the provisioning entry point (never by the app).
B4_ADMIN_DATABASE_URL=postgresql+psycopg://autograder_platform:change-me-local-only@localhost:55432/autograder
B4_DB_ROLE=autograder_b4
B4_DB_PASSWORD=change-me
B4_DB_NAME=autograder

NATS_URL=nats://localhost:54222

# Ed25519 signing key. Generate with:
#   uv run python -m autograder_b4.ops.generate_key
JWT_PRIVATE_KEY_FILE=secrets/jwt-ed25519.pem
B4_JWT_ISSUER=autograder-b4
B4_JWT_AUDIENCE=autograder
B4_ACCESS_TOKEN_TTL_SECONDS=900
B4_REFRESH_TOKEN_TTL_SECONDS=1209600

# Repository root holding the B1..B4 module.yaml files, used by the runtime registry.
# B4_MODULE_ROOT=D:/VScodeProjects/AutoGrader
