# B5 configuration -- variable NAMES only, never real values.
#
# The composition host gives each module its own settings view (ADR-0008): a `B5_`-prefixed
# variable is re-exposed to B5 under its unprefixed name, so `B5_CONTRACTS_DIR` becomes
# `CONTRACTS_DIR` for B5 only. Under a host, set the prefixed names; running B5 standalone,
# set the plain ones.
#
# Every value below has a working default for the local integration layout
# (`MAIN/docs/runbooks/integration.md`), so an integrated deployment normally sets none of
# them. Copy this file to `.env` only when overriding.

# Where MAIN's contract tree lives. Default: <repository>/MAIN/contracts.
CONTRACTS_DIR=

# B4's published key set. The name is B4's because the key set is B4's published surface
# (GET /api/v1/auth/jwks); B3 consumes it under the same name.
# Default: http://127.0.0.1:18000/api/v1/auth/jwks
B4_JWKS_URL=

# What B4 issues in this deployment. Defaults: `autograder` / `autograder-api`.
JWT_ISSUER=
JWT_AUDIENCE=
