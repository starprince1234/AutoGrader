DATABASE_URL=postgresql+psycopg://autograder_b2:change-me@localhost:55432/autograder
NATS_URL=nats://localhost:54222
NSJAIL_PATH=nsjail

# 评语轨（RQ-T-20 / ADR-0009）：**默认关闭**——下面四项一个都不给时，GET 返回 status=unavailable、
# POST 返回 409 并指名缺什么，且不产生任何出网调用。要启用就四项都给全，并自行承担数据出境责任
# （外传的内容只有已落库的结构化证据：逐用例结论、静态命中、安全结论、分数构成）。
# B2_COMMENTARY_PROVIDER=openai-compatible
# B2_COMMENTARY_BASE_URL=https://model.example.invalid/v1
# B2_COMMENTARY_MODEL=example-model
# B2_COMMENTARY_API_KEY_FILE=/run/secrets/commentary-key
# B2_COMMENTARY_TIMEOUT_SECONDS=30

# 成绩导出所需的 B4 名单读取（CHG-0029）。未配置时导出**拒绝**生成缺姓名的文件（503），
# 而不是输出一份看起来成功的残缺成绩单。B2 转交调用者自己的 bearer token，不新增服务凭据。
# B2_B4_BASE_URL=https://b4.example.invalid
# B2_B4_TIMEOUT_SECONDS=10

# 学生分层学习提示（AI-FLOW-01B）：provider 复用上面的 B2_COMMENTARY_*（不新增供应商）。
# 下面三项是部署预算；默认值已是有界值，不需要为了"能跑"而改。
# B2_LEARNING_HINTS_WINDOW_HOURS=24
# B2_LEARNING_HINTS_MAX_PER_WINDOW=20
# B2_LEARNING_HINT_TEXT_LIMIT=600
# B2_LEARNING_HINT_TITLE_LIMIT=80

# 可选的 B3 公开题目上下文（成员三提供的 learning-context 安全视图）。
# 未配置 = 只使用已落库的评测证据（少读更安全）；配置后必须包含 {question_version_id} 占位符。
# B2_LEARNING_CONTEXT_PATH=/api/v1/question-versions/{question_version_id}/learning-context
