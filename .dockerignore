# Build context for `MAIN/host/Dockerfile` (context = the repository root).
#
# B1 is deployed separately by Vercel. The local integration image needs Python modules,
# contracts, and module manifests only; built frontend assets are not part of that image.

# --- version control, virtualenvs, caches -------------------------------------------
**/.git
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.tsbuildinfo
**/*.pyc
**/coverage
**/.pytest-tmp

# --- build output (produced by Vercel or local tooling) ------------------------------
**/dist
**/build
**/*.egg-info

# --- local runtime state and secrets (must never enter an image layer) ---------------
**/.env
**/.env.integration
**/.runtime
**/secrets

# --- not part of the runtime ----------------------------------------------------------
B3/taskone
B3/tools/reporting
B3/prodction
MAIN/references
MAIN/课程开发项目-思维导图.pdf
MAIN/课程项目需求列表.xlsx
MAIN/项目初始化与项目文档管理.md
